---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import CoverImage from "@/components/common/CoverImage.astro";
import { siteConfig } from "@/config";
import { getApiUrlList, processCoverImageSync } from "@/utils/image-utils";
import { getFileDirFromPath } from "@/utils/url-utils";

interface Props {
	class?: string;
	entry: CollectionEntry<"posts">;
	title: string;
	url: string;
	published: Date;
	updated?: Date;
	tags: string[];
	category: string | null;
	image: string;
	description: string;
	draft: boolean;
	pinned?: boolean;
	password?: boolean;
	style: string;
	loading?: "lazy" | "eager";
}
const {
	entry,
	title,
	url,
	tags,
	image,
	pinned,
	password,
	style,
	loading = "lazy",
} = Astro.props;
const className = Astro.props.class;

// 处理随机图：如果image为"api"，则从配置的API获取随机图
const processedImage = processCoverImageSync(image, entry.id);
const apiUrls = getApiUrlList(image, entry.id);
const hasCover =
	processedImage !== undefined &&
	processedImage !== null &&
	processedImage !== "";

const showTags = siteConfig.postListLayout.showTags;

// 用于封面叠加模式：最多显示3个标签
const visibleTags = tags ? tags.slice(0, 3) : [];
const hiddenTagCount = tags ? Math.max(tags.length - 3, 0) : 0;
---

<!-- ==================== Grid模式 Bangumi风格卡片（有封面图） ==================== -->
{
  hasCover && (
    <a
      href={url}
      class:list={[
        "post-card-bangumi group relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg hover:scale-[1.02] block onload-animation post-card-item",
        className,
      ]}
      style={style}
      aria-label={title}
    >
      <div class="aspect-2/3 relative overflow-hidden">
        <CoverImage
          src={processedImage}
          basePath={getFileDirFromPath(entry.filePath || "")}
          alt={title}
          class="w-full h-full object-cover pointer-events-none transition-transform duration-500 group-hover:scale-105"
          preview={true}
          loading={loading}
          apiUrls={apiUrls}
        />

        <!-- 置顶标记 -->
        {pinned && (
          <div class="absolute top-2 left-2 px-2 py-1 rounded-full text-xs text-white font-medium bg-(--primary) z-10">
            <Icon name="material-symbols:push-pin" class="inline text-xs align-middle" />
          </div>
        )}

        <!-- 加密标记 -->
        {password && (
          <div class="absolute top-2 right-2 px-2 py-1 rounded-full text-xs text-white font-medium bg-black/50 backdrop-blur-sm z-10">
            <Icon name="material-symbols:lock-outline" class="inline text-xs align-middle" />
          </div>
        )}

        <!-- 渐变遮罩 + 信息层 -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent pointer-events-none" />
        <div class="absolute bottom-0 left-0 right-0 p-3">
          <h3 class="font-bold text-sm text-white line-clamp-2 drop-shadow-lg">
            {title}
          </h3>

          {showTags && visibleTags.length > 0 && (
            <div class="flex flex-wrap gap-1 mt-1.5">
              {visibleTags.map((tag) => (
                <span class="text-[0.6rem] px-1.5 py-0.5 rounded bg-white/20 text-white/90 backdrop-blur-sm">
                  {tag.trim()}
                </span>
              ))}
              {hiddenTagCount > 0 && (
                <span class="text-[0.6rem] px-1.5 py-0.5 rounded bg-white/20 text-white/60 backdrop-blur-sm">
                  +{hiddenTagCount}
                </span>
              )}
            </div>
          )}
        </div>
      </div>
    </a>
  )
}

<!-- ==================== Grid模式 无封面图的卡片 ==================== -->
{
  !hasCover && (
    <a
      href={url}
      class:list={[
        "post-card-bangumi-no-cover group relative overflow-hidden rounded-xl transition-all duration-300 hover:shadow-lg hover:scale-[1.02] block onload-animation post-card-item",
        "bg-gray-200 dark:bg-gray-700",
        className,
      ]}
      style={style}
      aria-label={title}
    >
      <div class="aspect-2/3 relative overflow-hidden flex items-center justify-center">
        <div class="text-gray-400 dark:text-gray-500 text-4xl mb-2">
          <Icon name="material-symbols:article-outline" />
        </div>

        <!-- 置顶标记 -->
        {pinned && (
          <div class="absolute top-2 left-2 px-2 py-1 rounded-full text-xs text-white font-medium bg-(--primary) z-10">
            <Icon name="material-symbols:push-pin" class="inline text-xs align-middle" />
          </div>
        )}

        <!-- 加密标记 -->
        {password && (
          <div class="absolute top-2 right-2 px-2 py-1 rounded-full text-xs text-white font-medium bg-black/50 backdrop-blur-sm z-10">
            <Icon name="material-symbols:lock-outline" class="inline text-xs align-middle" />
          </div>
        )}

        <!-- 渐变遮罩 + 信息层 -->
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent pointer-events-none" />
        <div class="absolute bottom-0 left-0 right-0 p-3">
          <h3 class="font-bold text-sm text-white line-clamp-2 drop-shadow-lg">
            {title}
          </h3>

          {showTags && visibleTags.length > 0 && (
            <div class="flex flex-wrap gap-1 mt-1.5">
              {visibleTags.map((tag) => (
                <span class="text-[0.6rem] px-1.5 py-0.5 rounded bg-white/20 text-white/90 backdrop-blur-sm">
                  {tag.trim()}
                </span>
              ))}
              {hiddenTagCount > 0 && (
                <span class="text-[0.6rem] px-1.5 py-0.5 rounded bg-white/20 text-white/60 backdrop-blur-sm">
                  +{hiddenTagCount}
                </span>
              )}
            </div>
          )}
        </div>
      </div>
    </a>
  )
}
